  "version": "0.0.0",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build:server": "tsc -p tsconfig.electron.json",
    "build:ui": "tsc -b && vite build",
    "build": "npm run build:server && npm run build:ui",
    "lint": "eslint .",
    "preview": "vite preview",
    "start:react": "vite",
    "start:electron": "npm run build:server && wait-on http://localhost:5173 && electron .",
    "dev:electron": "concurrently -k \"npm:start:react\" \"npm:start:electron\"",
    "build:electron": "npm run build && electron-builder"
  },
